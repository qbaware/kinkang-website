---
import Layout from '~/layouts/LandingPage.astro';

import Header from '~/components/widgets/Header.astro';
import Hero3 from '~/components/widgets/Hero3.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Brands from '~/components/widgets/Brands.astro';
import Steps from '~/components/widgets/Steps.astro';

import { headerData } from '~/navigation';

const metadata = {
  title: 'Home',
};
---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <Header {...headerData} isSticky={true} />
  </Fragment>

  <!-- Hero3 Widget ******************* -->

  <Hero3
    actions={[
      {
        variant: 'primary',
        text: 'Get Started',
        href: '/contact',
      },
      { text: 'Learn More', href: '#why-use-kinkang' },
    ]}
    image={{
      src: '~/assets/images/hero-mandarina5.svg',
      alt: 'Kinkang high-level architecture',
    }}
    bg={`
      <div class="absolute inset-0 -z-10 overflow-hidden rounded-bl-[50px] rounded-br-[50px] bg-[#fafafa]"></div>
    `}
  >
    <Fragment slot="title">
      Your
      <span class="font-bold">Kafka</span>
      cluster. Properly
      <span class="font-bold">Managed</span>.
    </Fragment>

    <Fragment slot="subtitle">
      <br />
      Operating Apache Kafka clusters at scale is complex and requires a number of experienced engineers. Well, not anymore!
      <br />
      <br />
      We provide managed <a href="https://github.com/linkedin/cruise-control">Cruise Control</a>*
      instances that automatically balance, heal, and scale Kafka clusters.
    </Fragment>
  </Hero3>

  <!-- Features3 Widget ************** -->

  <Features3
    id="why-use-kinkang"
    title="Why use Kinkang?"
    tagline="Overview"
    subtitle="Let's list some reasons"
    columns={2}
    items={[
      {
        title: 'Focus On What Matters',
        description:
          'Let us handle the complexities of your Kafka cluster while you focus on your core business. Business velocity is key, and we ensure your Kafka cluster runs smoothly so you can concentrate on delivering value to your customers.',
        icon: 'tabler:focus-2',
      },
      {
        title: 'Save Time & Money',
        description:
          "By trusting our team, you save your team's time and your business' money. Instead of having 5, 10, or even more engineers managing your Kafka cluster, you can have only a handful that work with us.",
        icon: 'tabler:pig-money',
      },
      {
        title: 'Operating Kafka Is Hard',
        description:
          'Kafka is incredibly complex to run at scale. Imbalances can lead to anything from just inefficient resource usage and unnecessary costs to throughput degradations, partial unavailability risks, or even full-blown downtime.',
        icon: 'tabler:fire-extinguisher',
      },
      {
        title: 'Industry-Standard Tech',
        description: `Kinkang is built on <a href="https://github.com/linkedin/cruise-control">Cruise Control</a>, the default go-to tool in the industry for Kafka management. It's an open-source tool designed to greatly simplify the management of Kafka clusters.`,
        icon: 'tabler:chess-king',
      },
      {
        title: 'We Have The Experience & Know-How',
        description:
          'As ex-employees at one of the most popular Kafka providers on the market, our team has a combined experience of more than a decade in managing and optimizing Kafka clusters at an enornous, world-class scale.',
        icon: 'tabler:rocket',
      },
      {
        title: 'Support',
        description:
          "We'll be there to help if something goes sideways. We'll be there to help you scale. We'll be there to consult you when necessary.",
        icon: 'tabler:headset',
      },
    ]}
    classes={{ container: 'max-w-5xl' }}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Core capabilities"
    subtitle="What Kinkang can do for you"
    tagline="Capabilities"
    items={[
      {
        title: 'Cluster Expansion',
        description: 'Add new brokers to your Kafka cluster to increase its capabilities.',
        icon: 'flat-color-icons:bullish',
      },
      {
        title: 'Cluster Shrink',
        description:
          'Remove brokers to scale down your Kafka cluster to optimize costs when the additional capacity is not needed.',
        icon: 'flat-color-icons:bearish',
      },
      {
        title: 'Automatic Rebalancing',
        description:
          'Based on changes in the running workload, topic partitions will be automatically reassigned to ensure optimal resource utilization.',
        icon: 'flat-color-icons:dam',
      },
      {
        title: 'Self-Healing',
        description:
          'This includes features like broker failure detection which automatically decomissions broken brokers, broken disk detection, and others.',
        icon: 'flat-color-icons:plus',
      },
      {
        title: 'Enforcing Resiliency',
        description:
          'Kinkang enforces resiliency by ensuring that topic partitions are evenly distributed across brokers in different AZs, preventing data loss and ensuring high availability.',
        icon: 'flat-color-icons:data-protection',
      },
      {
        title: 'Manual Rebalancing',
        description:
          'When the cluster is not automatically rebalancing due to not being imbalanced enough, you can still trigger a rebalance.',
        icon: 'flat-color-icons:reading-ebook',
      },
      {
        title: 'API',
        description:
          "For more advanced use cases, there's an available REST API that you can leverage to build any form of tooling around Kinkang.",
        icon: 'flat-color-icons:crystal-oscillator',
      },
      {
        title: 'Notifications',
        description:
          "If you're interested in receiving Slack notifications when an anomaly is detected, we can set that up for you.",
        icon: 'flat-color-icons:about',
      },
      {
        title: 'Others',
        description: 'There are many more features that Kinkang provides.',
        icon: 'flat-color-icons:menu',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- Brands Widget ****************** -->

  <Brands
    title="Companies trusting Cruise Control"
    subtitle="We weren't joking about Cruise Control being an industry standard"
    tagline="Adoption"
    icons={[]}
    images={[
      {
        src: '~/assets/images/logos/linkedin.png',
        alt: 'LinkedIn',
      },
      {
        src: '~/assets/images/logos/uber2.svg',
        alt: 'Uber',
      },
      {
        src: '~/assets/images/logos/netflix.png',
        alt: 'Netflix',
      },
      {
        src: '~/assets/images/logos/apple.png',
        alt: 'Apple',
      },
      {
        src: '~/assets/images/logos/slack3.svg',
        alt: 'Slack',
      },
      {
        src: '~/assets/images/logos/alibaba.png',
        alt: 'Alibaba',
      },
      {
        src: '~/assets/images/logos/adobe.svg',
        alt: 'Adobe',
      },
      {
        src: '~/assets/images/logos/shopify.svg',
        alt: 'Shopify',
      },
      {
        src: '~/assets/images/logos/intuit.svg',
        alt: 'Intuit',
      },
    ]}
  />

