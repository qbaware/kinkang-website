---
import Layout from '~/layouts/LandingPage.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Contact',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText
    tagline="Contact"
    title="Let's Connect!"
    subtitle="For quicker answers, explore our FAQs section. You may find the solution you're looking  for right there! If not, our team will help you."
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Reach out directly"
    items={[
      {
        title: 'Slack',
        description: 'danielgospodinow@qbaware.com',
        icon: 'tabler:brand-slack',
      },
      {
        title: 'Email',
        description: 'info@qbaware.com',
        icon: 'tabler:mail',
      },
      {
        title: 'Meeting',
        description: 'calendar.app.google/Pw8uZYid5pvewWCN9',
        icon: 'tabler:video',
      },
    ]}
  />

  <ContactUs
    id="form"
    title="Or drop us a message"
    action="https://api.web3forms.com/submit"
    method="POST"
    inputs={[
      {
        type: 'hidden',
        name: 'access_key',
        value: '5199bc6e-a2c1-4c89-80bd-d7523731e7f2',
      },
      {
        type: 'text',
        name: 'name',
        label: 'Name',
      },
      {
        type: 'email',
        name: 'email',
        label: 'Email',
      },
    ]}
    textarea={{
      label: 'Message',
      name: 'message',
    }}
    description="Our support team typically responds within 1-2 business days."
  />
</Layout>
