---
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'About us',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    image={{
      src: '~/assets/images/kinkang-team.jpeg',
      alt: 'Team',
    }}
  >
    <Fragment slot="title"> And here we are </Fragment>

    <Fragment slot="subtitle">
      Three friends with a shared passion for Kafka and distributed systems in general
    </Fragment>
  </Hero>

  <!-- Features2 Widget ************** -->

  <Features2
    title="About us"
    tagline="The Team"
    subtitle="We're a team of three engineers that met each other at Confluent who afterward became close friends and decided to build a world-class product together in the Apache Kafka space. A product that we have the expertise of building and maintaining. A product that we would be proud of. A product that would help businesses across the world scale efortlessly."
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="Our values"
    subtitle="Our team is built on a foundation of core values that guide our actions and decisions. These values are not just words, but principles that we live by every day."
    items={[
      {
        title: 'Customer Love',
        description:
          "Earning and keeping our customers' trust is our top priority. Just like any business, we want to deliver value with great quality so that both we and our customers thrive.",
      },
      {
        title: 'Get Sh*t Done',
        description: 'Sometimes we just have to roll up our sleeves and get our hands dirty with some unplanned and unexpected yet high-return tasks. Our team is good at this.',
      },
      {
        title: 'One Team',
        description:
          "Maybe it's obvious, but it's super important. We are one team! We work together, we struggle together, we grow together, and we celebrate our successes together.",
      },
    ]}
  />

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="Achievements"
    subtitle="Not to brag, but we are proud of what we have achieved so far. We have a long way to go, but we are confident that we will get there."
    isReversed={true}
    items={[
      {
        title: 'Global reach',
        description: 'Nam malesuada urna in enim imperdiet tincidunt. Phasellus non tincidunt nisi, at elementum mi.',
        icon: 'tabler:globe',
      },
      {
        title: 'Positive customer feedback and reviews',
        description:
          'Cras semper nulla leo, eget laoreet erat cursus sed. Praesent faucibus massa in purus iaculis dictum.',
        icon: 'tabler:message-star',
      },
      {
        title: 'Awards and recognition as industry experts',
        description:
          'Phasellus lacinia cursus velit, eu malesuada magna pretium eu. Etiam aliquet tellus purus, blandit lobortis ex rhoncus vitae.',
        icon: 'tabler:award',
      },
    ]}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Where we operate"
    tagline="Locations"
    columns={2}
    items={[
      {
        title: 'United Kingdom',
        description: 'London',
      },
      {
        title: 'Spain',
        description: 'Madrid',
      },
      {
        title: 'Bulgaria',
        description: 'Sofia',
      },
    ]}
  />
</Layout>
