---
import Layout from '~/layouts/LandingPage.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Contact',
};
---

<Layout metadata={metadata}>
  <HeroText tagline="Work In Progress" title="Coming soon!" />

  <CallToAction
    id="contact-us"
    actions={[
      {
        variant: 'primary',
        text: 'Contact us',
        href: '/contact',
      },
    ]}
  >
    <Fragment slot="title">Interested?</Fragment>
    <Fragment slot="subtitle"> Reach out and we can share more. </Fragment>
  </CallToAction>
</Layout>
