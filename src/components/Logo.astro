---
import { SITE } from 'astrowind:config';
import { Image } from 'astro:assets';
import logoImage from '../assets/images/logo2.svg';
---

<span class="flex items-center self-center ml-2 rtl:ml-0 rtl:mr-2 text-2xl md:text-xl font-bold font-sans text-gray-900 whitespace-nowrap dark:text-white">
  <Image 
    src={logoImage} 
    alt={SITE?.name || 'Logo'} 
    width={35} 
    height={35} 
    class="mr-2 rtl:mr-0 rtl:ml-2" 
  />
  kinkang
</span>
